{
  "name": "@local/rverilator-wasm-playground",
  "version": "0.1.0",
  "private": true,
  "description": "In-Harness Verilog playground over the react-cad-suite wasm engine (rverilator + riverilog→rivvp) with VCD waveforms.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
